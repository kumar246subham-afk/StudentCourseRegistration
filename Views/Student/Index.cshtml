@model List<StudentCourseRegistration.Models.Student>
@{
    ViewData["Title"] = "Student List";
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-people-fill text-primary me-2"></i>Registered Students Directory
        </h2>
        <p class="text-muted mb-0">Total Enrolled Students: <span class="badge bg-primary">@Model.Count</span> &bull; Marwadi University Course Enrolment</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i> Register New Student
        </a>
    </div>
</div>

<!-- Student List Table -->
<div class="card shadow-sm border">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <span><i class="bi bi-table me-2"></i>Enrolled Student List (Index View)</span>
        <small class="text-secondary">Data passed from StudentController to Razor View</small>
    </div>
    <div class="card-body p-0">
        @if (Model == null || Model.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                <p>No students have been registered yet.</p>
                <a asp-action="Create" class="btn btn-sm btn-primary">Register the first student</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-secondary">
                        <tr>
                            <th style="width: 70px;" class="text-center">ID</th>
                            <th>Student Name</th>
                            <th>Email Address</th>
                            <th>Enrolled Course</th>
                            <th class="text-center">Semester</th>
                            <th>Registered On</th>
                            <th class="text-center" style="width: 140px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in Model)
                        {
                            <tr>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">#@student.Id</span>
                                </td>
                                <td class="fw-bold text-dark">
                                    <i class="bi bi-person-circle text-primary me-1"></i>@student.Name
                                </td>
                                <td>
                                    <a href="mailto:@student.Email" class="text-decoration-none">@student.Email</a>
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark">@student.Course</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary">Sem @student.Semester</span>
                                </td>
                                <td class="text-muted small">
                                    @student.RegistrationDate.ToString("dd-MMM-yyyy hh:mm tt")
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye-fill me-1"></i> Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="mt-3 text-muted small">
    <i class="bi bi-info-circle me-1"></i>
    <strong>Application Flow Note:</strong> According to Section 6 of the assignment, only valid registrations processed by <code>ModelState.IsValid</code> appear in this directory.
</div>
